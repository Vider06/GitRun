#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="GitRun"
CONFIG_FILE="${GITRUN_CONFIG:-${GITRUN_CONFIG_FILE:-/etc/gitrun/gitrun.env}}"
STATE_DIR="${GITRUN_STATE_DIR:-/var/lib/gitrun}"
LOG_DIR="${GITRUN_LOG_DIR:-/var/log/gitrun}"
COMPOSE_FILE="${GITRUN_COMPOSE_FILE:-/opt/gitrun/docker-compose.yml}"

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
    fi

    : "${GITRUN_MIN_RUNNERS:=3}"
    : "${GITRUN_MAX_RUNNERS:=8}"
    : "${GITRUN_IDLE_TIMEOUT:=120}"
    : "${GITRUN_POLL_INTERVAL:=5}"
    : "${GITRUN_DEFAULT_REPOSITORY:=}"
}

die() {
    echo "GitRun: $*" >&2
    exit 1
}

have() {
    command -v "$1" >/dev/null 2>&1
}

docker_available() {
    have docker && docker info >/dev/null 2>&1
}

repo_from_arg_or_default() {
    local repo="${1:-${GITRUN_DEFAULT_REPOSITORY}}"
    [[ -n "$repo" ]] || die "No repository selected. Use: gitrun connect <owner/repo> or set GITRUN_DEFAULT_REPOSITORY."
    printf '%s\n' "$repo"
}

cmd_help() {
    cat <<'EOF'
GitRun — GitHub self-hosted runner control plane

Usage:
  gitrun <command> [arguments]

Core:
  overview                 Show the global GitRun overview.
  status                   Show Docker/container status.
  runners                 Show managed runner containers.
  jobs                    Show managed runner containers/jobs.
  health                   Run a health check.
  doctor                   Diagnose GitRun host dependencies.
  logs [runner]            Show GitRun or runner logs.
  last-crash               Show the latest recorded crash information.
  usage                    Show local Docker resource usage.

Lifecycle:
  start                    Start the GitRun stack.
  stop                     Stop the GitRun stack.
  restart                  Restart the GitRun stack.

Configuration:
  connect <owner/repo>     Add a repository to GitRun.
  repositories             List configured repositories.
  config                   Print current effective configuration.
  version                  Show GitRun version.

Notes:
  - GitRun manages self-hosted runners through Docker.
  - The default pool is 3 warm runners, up to 8.
  - Extra runners remain alive for 120 seconds after becoming idle.
EOF
}

cmd_version() {
    echo "$APP_NAME 0.1.0"
}

cmd_config() {
    load_config
    cat <<EOF
GitRun configuration
  config file:      $CONFIG_FILE
  state dir:        $STATE_DIR
  log dir:          $LOG_DIR
  compose file:     $COMPOSE_FILE
  min runners:      $GITRUN_MIN_RUNNERS
  max runners:      $GITRUN_MAX_RUNNERS
  idle timeout:     $GITRUN_IDLE_TIMEOUT s
  poll interval:    $GITRUN_POLL_INTERVAL s
  repositories:     ${GITRUN_REPOSITORIES:-<none>}
EOF
}

cmd_doctor() {
    load_config
    local failed=0

    check() {
        local label="$1"
        shift
        if "$@"; then
            printf '[PASS] %s\n' "$label"
        else
            printf '[FAIL] %s\n' "$label"
            failed=1
        fi
    }

    echo "GitRun doctor"
    check "bash" have bash
    check "docker command" have docker
    check "Docker daemon" docker_available
    check "config syntax" bash -n "$0"

    if [[ -f "$COMPOSE_FILE" ]]; then
        if docker_available; then
            check "compose file" docker compose -f "$COMPOSE_FILE" config -q
        else
            echo "[SKIP] compose validation (Docker daemon unavailable)"
        fi
    else
        echo "[WARN] compose file missing: $COMPOSE_FILE"
    fi

    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        echo "[PASS] GitHub token configured"
    else
        echo "[WARN] GitHub token not configured"
    fi

    if (( failed )); then
        return 1
    fi

    echo "GitRun doctor: PASS"
}

cmd_status() {
    load_config
    if ! docker_available; then
        echo "Docker daemon unavailable."
        return 1
    fi

    docker ps --filter 'label=gitrun.runner=true' --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.RunningFor}}'
}

cmd_runners() {
    load_config
    if ! docker_available; then
        echo "Docker daemon unavailable."
        return 1
    fi

    docker ps -a --filter 'label=gitrun.runner=true' \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Labels}}'
}

cmd_logs() {
    load_config
    local target="${1:-}"
    if ! docker_available; then
        echo "Docker daemon unavailable."
        return 1
    fi

    if [[ -n "$target" ]]; then
        docker logs --tail 200 "$target"
        return
    fi

    if docker ps -a --format '{{.Names}}' | grep -Fxq gitrun-manager; then
        docker logs --tail 200 gitrun-manager
        return
    fi

    if [[ -f "$LOG_DIR/gitrun.log" ]]; then
        tail -n 200 "$LOG_DIR/gitrun.log"
    else
        echo "No GitRun log file yet: $LOG_DIR/gitrun.log"
    fi
}

cmd_last_crash() {
    load_config
    local crash_file="$STATE_DIR/last-crash"
    if [[ -f "$crash_file" ]]; then
        cat "$crash_file"
    else
        echo "No recorded crashes."
    fi
}

cmd_usage() {
    load_config
    if ! docker_available; then
        echo "Docker daemon unavailable."
        return 1
    fi

    docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}'
}

cmd_health() {
    load_config
    local failed=0

    if docker_available; then
        echo "[PASS] Docker"
    else
        echo "[FAIL] Docker"
        failed=1
    fi

    if [[ -f "$COMPOSE_FILE" ]]; then
        echo "[PASS] Compose configuration present"
    else
        echo "[FAIL] Compose configuration missing: $COMPOSE_FILE"
        failed=1
    fi

    local min="${GITRUN_MIN_RUNNERS}"
    if (( min < 1 )); then
        echo "[FAIL] Invalid minimum runner count: $min"
        failed=1
    else
        echo "[PASS] Minimum runners: $min"
    fi

    if (( GITRUN_MAX_RUNNERS < GITRUN_MIN_RUNNERS )); then
        echo "[FAIL] max runners is below min runners"
        failed=1
    else
        echo "[PASS] Runner capacity: $GITRUN_MIN_RUNNERS..$GITRUN_MAX_RUNNERS"
    fi

    if docker_available; then
        if docker ps -a --format '{{.Names}}' | grep -Fxq gitrun-manager; then
            echo "[PASS] GitRun manager container"
        else
            echo "[FAIL] GitRun manager container missing"
            failed=1
        fi
    fi

    if (( failed )); then
        return 1
    fi

    echo "GitRun health: PASS"
}

cmd_overview() {
    load_config
    echo
    echo "GitRun"
    echo "=============================================="
    echo "Repositories: ${GITRUN_REPOSITORIES:-<none>}"
    echo "Pool:         $GITRUN_MIN_RUNNERS .. $GITRUN_MAX_RUNNERS"
    echo "Warm time:    $GITRUN_IDLE_TIMEOUT seconds"
    echo "Polling:      $GITRUN_POLL_INTERVAL seconds"
    echo

    if docker_available; then
        local total running
        total="$(docker ps -a --filter 'label=gitrun.runner=true' -q | wc -l)"
        running="$(docker ps --filter 'label=gitrun.runner=true' -q | wc -l)"
        echo "Runners:      $running active / $total known"
    else
        echo "Runners:      Docker unavailable"
    fi
    echo
}

cmd_start() {
    [[ -f "$COMPOSE_FILE" ]] || die "Compose file not found: $COMPOSE_FILE"
    docker compose -f "$COMPOSE_FILE" up -d
}

cmd_stop() {
    [[ -f "$COMPOSE_FILE" ]] || die "Compose file not found: $COMPOSE_FILE"
    docker compose -f "$COMPOSE_FILE" stop
}

cmd_restart() {
    [[ -f "$COMPOSE_FILE" ]] || die "Compose file not found: $COMPOSE_FILE"
    docker compose -f "$COMPOSE_FILE" restart
}

cmd_repositories() {
    load_config
    echo "Configured repositories:"
    if [[ -n "${GITRUN_REPOSITORIES:-}" ]]; then
        tr ',' '\n' <<< "$GITRUN_REPOSITORIES"
    elif [[ -n "${GITRUN_DEFAULT_REPOSITORY:-}" ]]; then
        echo "$GITRUN_DEFAULT_REPOSITORY"
    else
        echo "<none>"
    fi
}

cmd_service() {
    local action="${1:-status}"
    case "$action" in
        status|start|stop|restart|enable|disable)
            sudo systemctl "$action" gitrun.service
            ;;
        *) die "Usage: gitrun service {status|start|stop|restart|enable|disable}" ;;
    esac
}

cmd_connect() {
    local repo="${1:-}"
    [[ "$repo" =~ ^[^/]+/[^/]+$ ]] || die "Usage: gitrun connect <owner/repo>"

    mkdir -p "$(dirname "$CONFIG_FILE")"
    touch "$CONFIG_FILE"

    if grep -q '^GITRUN_REPOSITORIES=' "$CONFIG_FILE"; then
        local current
        current="$(grep '^GITRUN_REPOSITORIES=' "$CONFIG_FILE" | head -n1 | cut -d= -f2-)"
        if ! tr ',' '\n' <<< "$current" | grep -Fxq "$repo"; then
            if [[ -n "$current" ]]; then
                current="$current,$repo"
            else
                current="$repo"
            fi
            sed -i "s|^GITRUN_REPOSITORIES=.*|GITRUN_REPOSITORIES=$current|" "$CONFIG_FILE"
        fi
    else
        printf '\nGITRUN_REPOSITORIES=%s\n' "$repo" >> "$CONFIG_FILE"
    fi

    echo "Repository connected: $repo"
    echo "Run: gitrun repositories"
    echo "Then: sudo systemctl restart gitrun.service"
}

load_config

command="${1:-help}"
shift || true

case "$command" in
    help|-h|--help) cmd_help ;;
    version) cmd_version ;;
    config) cmd_config ;;
    doctor) cmd_doctor ;;
    status) cmd_status ;;
    runners) cmd_runners ;;
    jobs) cmd_runners ;;
    logs) cmd_logs "$@" ;;
    last-crash) cmd_last_crash ;;
    usage) cmd_usage ;;
    health) cmd_health ;;
    overview) cmd_overview ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    connect) cmd_connect "$@" ;;
    repositories|repos) cmd_repositories ;;
    service) cmd_service "$@" ;;
    *) die "Unknown command: $command. Run 'gitrun help'." ;;
esac
