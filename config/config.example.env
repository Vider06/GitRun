# GitRun runtime configuration.
# Copy to /etc/gitrun/gitrun.env and chmod 600.
#
# GITHUB_TOKEN must be able to administer repository self-hosted runners
# and read Actions workflow/job state for each managed private repository.
GITHUB_TOKEN=

# Managed repositories, comma separated.
GITRUN_REPOSITORIES=Vider06/Eridania_Site

# Pool policy.
GITRUN_MIN_RUNNERS=3
GITRUN_MAX_RUNNERS=20
GITRUN_IDLE_TIMEOUT=120
GITRUN_POLL_INTERVAL=5

# Runner image.
GITRUN_RUNNER_IMAGE=gitrun-runner:latest
# Keep the default labels compatible with normal self-hosted workflows.
GITRUN_RUNNER_LABELS=self-hosted,Linux,X64

# Persistent warm runners are used to honor the 3-runner warm pool.
# GitHub recommends ephemeral runners for autoscaling when security isolation
# is the priority. Set true if you want one-job disposable runners instead.
GITRUN_EPHEMERAL=false

# If true, runner updates are disabled and the image version must be updated
# regularly. Leave false for automatic runner updates.
GITRUN_DISABLE_UPDATE=false

# Per-runner resource caps. Tune to the mini-server's real hardware.
GITRUN_CONTAINER_CPUS=2
GITRUN_CONTAINER_MEMORY=4g
GITRUN_CONTAINER_PIDS=2048

GITRUN_LOG_LEVEL=INFO
GITRUN_STATE_DIR=/var/lib/gitrun
GITRUN_LOG_DIR=/var/log/gitrun
