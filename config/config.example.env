# GitHub authentication: use either a PAT or the GitHub App fields below.
GITHUB_TOKEN=

# Repositories managed by GitRun, comma-separated.
GITRUN_REPOSITORIES=owner/repository

# Legacy single-repository compatibility fallback. Used only when
# GITRUN_REPOSITORIES is unset or empty.
# GITRUN_DEFAULT_REPOSITORY=owner/repository

# Pool policy.
GITRUN_MIN_RUNNERS=3
GITRUN_MAX_RUNNERS=8
GITRUN_IDLE_TIMEOUT=120
GITRUN_POLL_INTERVAL=5

# Recover managed runners when self-hosted jobs are queued but a runner is offline.
GITRUN_AUTO_CONTAINER_RECOVERY=true
GITRUN_CONTAINER_RECOVERY_COOLDOWN=60

# Runner image and labels.
GITRUN_RUNNER_IMAGE=gitrun-runner:latest
GITRUN_RUNNER_LABELS=self-hosted,Linux,X64,gitrun-ci

# Use ephemeral runners when stronger job isolation is required.
GITRUN_EPHEMERAL=false

# Set true only when runner updates are managed through the image/GTUU.
GITRUN_DISABLE_UPDATE=false

# GTUU permanent runner maintenance.
GITRUN_AUTO_CONTAINER_UPDATE=false
GITRUN_CONTAINER_UPDATE_TIME=03:00
GITRUN_GTUU_SCHEDULE_TIMEZONE=utc

# Default resource caps for a small server.
GITRUN_CONTAINER_CPUS=1
GITRUN_CONTAINER_MEMORY=1g
GITRUN_CONTAINER_PIDS=1024

# Runner home storage.
# "tmpfs" is RAM-backed; "volume" uses a Docker-managed disk volume.
GITRUN_RUNNER_HOME_SIZE=8g
GITRUN_RUNNER_HOME_BACKEND=tmpfs

# Persistent GitRun directories.
GITRUN_STATE_DIR=/var/lib/gitrun
GITRUN_LOG_DIR=/var/log/gitrun

# Shared package-manager cache volume used by runner containers.
GITRUN_SHARED_CACHE_VOLUME=gitrun-runner-shared

# GitHub API timeouts, in seconds.
GITRUN_GITHUB_CONNECT_TIMEOUT=5
GITRUN_GITHUB_REQUEST_TIMEOUT=20

# GitHub App authentication (alternative to GITHUB_TOKEN).
# Leave these empty when using a PAT.
GITRUN_GITHUB_APP_ID=
GITRUN_GITHUB_APP_INSTALLATION_ID=
GITRUN_GITHUB_APP_PRIVATE_KEY_PATH=

# GitVault. Leave disabled/empty unless GitVault is configured.
GITRUN_VAULT_DIR=
GITRUN_VAULT_GROUPS=

# GSR Docker-socket hardening.
# Turning hardening off requires GITRUN_GSR_ALLOW_UNSAFE_RUNNER=true as well.
GITRUN_GSR_DOCKER_SOCKET_HARDENING=true
GITRUN_GSR_ALLOW_UNSAFE_RUNNER=false

# GSR command-policy enforcement.
GITRUN_GSR_COMMAND_POLICY_ENABLED=true
GITRUN_GSR_COMMAND_BASELINE_BLACKLIST_ENABLED=true
GITRUN_GSR_COMMAND_BLACKLIST_ENABLED=false
GITRUN_GSR_COMMAND_BLACKLIST=
GITRUN_GSR_COMMAND_WHITELIST_ENABLED=false
GITRUN_GSR_COMMAND_WHITELIST=

# Action taken for a command-policy violation:
# log_only, kill, or kill_and_ban.
GITRUN_GSR_VIOLATION_ACTION=kill

# Workflow-level security validation.
GITRUN_GSR_WORKFLOW_VALIDATION_ENABLED=true

# Optional zizmor static analysis.
# Enabling it requires the operator to accept its license/terms first.
GITRUN_GSR_ZIZMOR_ENABLED=false

# Managed by the dashboard's zizmor consent flow; do not set manually
# unless the operator has actually accepted the terms.
GITRUN_GSR_ZIZMOR_LICENSE_ACCEPTED=false

# Security hardening / scheduler sizing
GITRUN_HOST_PROFILE=standard
GITRUN_RESOURCE_PRESSURE_ENABLED=true
GITRUN_RESOURCE_PRESSURE_CPU_PERCENT=90
GITRUN_RESOURCE_PRESSURE_MEMORY_PERCENT=90
GITRUN_RESOURCE_PRESSURE_DISK_PERCENT=90
GITRUN_SHARED_CACHE_SCOPE=repository
GITRUN_RUNNER_NETWORK=bridge
GITRUN_RUNNER_SECCOMP_PROFILE=default
# Optional host-specific AppArmor profile name.
GITRUN_RUNNER_APPARMOR_PROFILE=

# Update manifest verification. Set the public key on update hosts.
# GITRUN_UPDATE_PUBLIC_KEY_HEX=<32-byte Ed25519 public key in hex>
# GITRUN_UPDATE_PUBLIC_KEY_ID=<trusted key identifier>
# GITRUN_UPDATE_SIGNATURE_REQUIRED=true
