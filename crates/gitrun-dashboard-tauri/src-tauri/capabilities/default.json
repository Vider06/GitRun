{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability granting the dashboard window access to GitRun's custom commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "get-overview",
    "get-repo-detail",
    "list-vault-secrets",
    "set-vault-secret",
    "delete-vault-secret",
    "get-gsr-status",
    "list-gsr-events",
    "list-logic-rules",
    "save-logic-rules",
    "list-vm-configs",
    "save-vm-config",
    "list-pending-hypervisor-decisions",
    "respond-hypervisor-decision",
    "get-config",
    "save-config"
  ]
}
