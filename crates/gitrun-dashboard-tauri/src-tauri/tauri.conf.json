{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitRun",
  "version": "1.6.0",
  "identifier": "dev.gitrun.dashboard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GitRun",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/gitrun-icon-32.png",
      "icons/gitrun-icon-128.png",
      "icons/gitrun-icon-256.png",
      "icons/gitrun-icon-512.png"
    ]
  }
}
