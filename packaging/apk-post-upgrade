#!/bin/sh
set -eu

# APK upgrades replace the service wrapper and binaries. Restart only services
# that were already active; package installation must not enable or start GitRun.
if command -v rc-service >/dev/null 2>&1; then
    for service in gitrun gitrun-gsr; do
        if rc-service "$service" status >/dev/null 2>&1; then
            rc-service "$service" restart || {
                echo "gitrun APK: warning: failed to restart active $service" >&2
            }
        fi
    done
fi

exit 0
