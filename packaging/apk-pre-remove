#!/bin/sh
set -eu

# Stop and unregister only GitRun services. Configuration, state and runner
# resources remain intact; destructive cleanup is an explicit GitRun command.
if command -v rc-service >/dev/null 2>&1; then
    for service in gitrun-gsr gitrun; do
        rc-service "$service" stop >/dev/null 2>&1 || true
        if command -v rc-update >/dev/null 2>&1; then
            rc-update del "$service" default >/dev/null 2>&1 || true
        fi
    done
fi

exit 0
