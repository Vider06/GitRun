#!/bin/sh
set -eu

while IFS='=' read -r key value; do
    case "$key" in
        GITHUB_TOKEN|GITRUN_*) export "$key=$value" ;;
    esac
done < /etc/gitrun/gitrun.env

if [ -x /usr/bin/gitrun ]; then
    executable=/usr/bin/gitrun
elif [ -x /usr/local/bin/gitrun ]; then
    executable=/usr/local/bin/gitrun
else
    echo "gitrun service: canonical GitRun executable was not found" >&2
    exit 127
fi

# Recovery is a separate diagnostic/startup application, not a drop-in CLI.
# OpenRC and runit service commands must be dispatched to the canonical CLI.
exec "$executable" "$@"
