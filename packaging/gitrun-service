#!/bin/sh
set -eu

while IFS='=' read -r key value; do
    case "$key" in
        GITHUB_TOKEN|GITRUN_*) export "$key=$value" ;;
    esac
done < /etc/gitrun/gitrun.env

if [ -x /usr/bin/gitrun ]; then
    executable=/usr/bin/gitrun
elif [ -x /usr/local/bin/gitrun ]; then
    executable=/usr/local/bin/gitrun
else
    echo "gitrun service: canonical GitRun executable was not found" >&2
    exit 127
fi
export GITRUN_BINARY_PATH="$executable"

# Recovery is a supervisor entrypoint, not a drop-in GitRun CLI. Use its
# explicit start subcommand only for scheduler startup; GSR runs the canonical
# GitRun CLI directly.
if [ "${1:-}" = "scheduler" ] && [ -x /usr/local/bin/gitrun-recovery ]; then
    shift
    exec /usr/local/bin/gitrun-recovery start scheduler "$@"
fi

exec "$executable" "$@"
