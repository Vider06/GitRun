#!/bin/sh
set -eu

# Never enable or start services during package installation. On an upgrade,
# restart only runit services that were already supervised and running.
case "${ACTION:-}" in
    post)
        if [ "${UPDATE:-no}" = "yes" ] && command -v sv >/dev/null 2>&1; then
            for service in gitrun gitrun-gsr; do
                path="/var/service/$service"
                if [ -L "$path" ] && sv status "$path" >/dev/null 2>&1; then
                    sv restart "$path" >/dev/null 2>&1 || {
                        echo "gitrun XBPS: warning: failed to restart active $service" >&2
                    }
                fi
            done
        fi
        ;;
esac

exit 0
