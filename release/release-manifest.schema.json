{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitRun Release Manifest",
  "type": "object",
  "required": ["name", "version", "git_commit", "artifacts"],
  "properties": {
    "name": { "const": "GitRun" },
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "file", "sha256"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "download_url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "minimum_version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "minimum_version": { "type": "string", "minLength": 1 },
          "recommended_version": { "type": "string" },
          "source": { "type": "string", "format": "uri" },
          "installation_method": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "runner_image": {
      "type": "object",
      "required": ["reference", "digest", "minimum_version"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "minimum_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
