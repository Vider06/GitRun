[Unit]
Description=GitRun privileged control manager for the desktop and terminal control panels
After=local-fs.target
Before=gitrun.service gitrun-gsr.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gitrun control-manager
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
RuntimeDirectory=gitrun-control
RuntimeDirectoryMode=2750
Group=gitrun-control
Environment=GITRUN_CONFIG_FILE=/etc/gitrun/gitrun.env
UMask=0007
# The manager is the sole privileged control-plane entry point for dashboard
# operations. The UIs remain unprivileged and can only use its typed local IPC.
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/etc/gitrun /var/lib/gitrun /var/log/gitrun /var/cache/gitrun /opt/gitrun /usr/share/gitrun /run/gitrun-control
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
