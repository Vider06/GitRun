[Unit]
Description=GitRun GSR (GitSecureRun) watchdog
After=gitrun.service
Wants=gitrun.service
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/gitrun/gitrun.env
ExecStart=/usr/local/bin/gitrun gsr-watchdog
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# GSR must remain a separate service so it survives a scheduler crash.
# This unit currently runs as root to read the configured state/config paths.
# Root therefore still has broad host privileges; a dedicated service identity
# requires coordinated ownership/permission changes in setup and is not implied
# by the sandbox settings below.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
