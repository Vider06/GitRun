[Unit]
Description=GitRun Docker runner autoscaler
Requires=docker.service
After=docker.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/gitrun
ExecStart=/usr/bin/docker compose -f /opt/gitrun/docker-compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f /opt/gitrun/docker-compose.yml down
RemainAfterExit=yes
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
