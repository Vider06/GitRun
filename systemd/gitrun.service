[Unit]
Description=GitRun Rust scheduler
Requires=docker.service
After=docker.service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gitrun scheduler
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
# The scheduler currently runs as root for Docker/mount orchestration. These
# restrictions reduce ambient attack surface but do not replace a least-
# privilege service identity or constrain the Docker daemon's host privileges.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
EnvironmentFile=/etc/gitrun/gitrun.env

[Install]
WantedBy=multi-user.target
